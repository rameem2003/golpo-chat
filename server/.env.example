PORT=5000
MONGO_URI=your mongo db url
MAIN_SITE_URL=http://localhost:3000
API_VERSION_BASE=/api/v1
JWT_SECRET=your jwt secret
SSL_STORE_ID=ssl commerz store id
SSL_STORE_PASSWORD=ssl commerz store password
NODEMAILER_HOST=host url
NODEMAILER_EMAIL=email address
NODEMAILER_PASS=email password
CLOUDINARY_CLOUD_NAME=your cloud name
CLOUDINARY_API_KEY=api key
CLOUDINARY_API_SECRET=secret key

SYSTEM_ENV = development (if you host in remote or vps please replace the string with "production")
